{
  // https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
  "config": {
    "default": true,
    "MD003": {
      "style": "atx"
    },
    "MD007": {
      "indent": 2
    },
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD033": false,
    "MD041": false,
    // Command-prompt files use sub-step numbering (e.g. 4a/4b) and deeply-indented
    // step content, which these rules misread as bad ordered-list prefixes / indented
    // code blocks. Disabled repo-wide so the structured prompts lint cleanly.
    "MD029": false,
    "MD046": false,
    "MD049": {
      "style": "asterisk"
    },
    "MD050": {
      "style": "asterisk"
    }
  },
  "ignores": [
    ".genreleases/"
  ]
}